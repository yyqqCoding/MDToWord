# 展示站服务端配置。所有密钥只存在于服务端，不得以 NEXT_PUBLIC_ 前缀暴露。
# 本文件只是配置名清单，不得填入任何真实值。
# 本地开发请复制为 .env.local（已被 .gitignore 忽略）后自行填写。
# 未配置 Supabase 时站点自动回落到构造数据，仍可正常运行。

# Supabase：以 service_role 读取 agent_run_public 视图与 agent_run_traces 表。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Langfuse：只在抓取 Trace 快照时使用（Agent 完成回调、详情页按需补抓、手动批量回填）。
# 页面读取快照表本身不调用 Langfuse。
# 区域必须与 Agent 的 .env 一致（本项目是 jp）
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Agent 运行完成回调的共享密钥，必须与 Agent 侧 TRACE_SITE_WEBHOOK_SECRET 完全一致。
# 未配置时 /api/hooks/run-finished 返回 503，站点退回按需补抓。
SITE_WEBHOOK_SECRET=

# 手动批量回填端点的校验值。已无定时调度，仅用于重刷历史或本地拉齐快照。
CRON_SECRET=

# GitHub 公开 PR diff。公开仓库无需 token，仅在触发限流时才需要提高配额。
GITHUB_REPO_OWNER=yyqqCoding
GITHUB_REPO_NAME=MDToWord
GITHUB_TOKEN=
