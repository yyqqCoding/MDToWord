# Supabase Agent Runtime
SUPABASE_URL=
SUPABASE_AGENT_KEY=
AGENT_DATABASE_URL=
AGENT_CHECKPOINT_SCHEMA=agent_runtime

# Gate Runtime
ARTIFACT_ROOT=var/agent-artifacts
EXTENSION_MANIFEST_PATH=extension/dist/manifest.json
CLAIM_LEASE_SECONDS=300
MAX_CLAIM_ATTEMPTS=3
MIN_GATE_CONFIDENCE=0.80
POLL_INTERVAL_SECONDS=5

# B3 OpenAI-compatible Provider
MODEL_PROVIDER=openai_compatible
MODEL_NAME=
MODEL_API_KEY=
# 填 API 根路径，例如 https://api.example.com/v1；不要包含 /chat/completions。
MODEL_BASE_URL=
# 若兼容接口不直接返回 usage.cost，请按所选模型价格填写美元/百万 Token。
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
# 阶段 D 长源码请求的单次模型超时，范围 30～300 秒。
REPRODUCTION_MODEL_TIMEOUT_SECONDS=180
# 阶段 E 全运行预算；达到任一上限后不再调用模型或 Sandbox。
MAX_MODEL_CALLS_PER_RUN=8
MAX_TOOL_CALLS_PER_RUN=30
MAX_TOTAL_TOKENS_PER_RUN=200000
MAX_SANDBOX_SECONDS_PER_RUN=900
# 固定后端基线的 skipped 数量；修复后增加即验证失败。
BACKEND_BASELINE_SKIPPED=0

# B3 Langfuse Cloud
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AGENT_ENVIRONMENT=development
TRACE_CONTENT=false

# Stage D/E Controller（--reproduce 或 --repair 时读取）
GITHUB_REPOSITORY=yyqqCoding/MDToWord
# Fine-grained token，仅授予该仓库 Contents: read；不得传入 Worker。
GITHUB_READ_TOKEN=
SOURCE_WORKSPACE_ROOT=var/source-snapshots
SANDBOX_WORKER_URL=http://127.0.0.1:8090
# Controller 与 Worker 分别注入同一个内部认证值，不传给任务容器。
SANDBOX_WORKER_CREDENTIAL=

# Stage C Worker-only（只注入 Worker，不传入任务容器）
SANDBOX_IMAGE_DIGEST=
SANDBOX_JOB_ROOT=var/sandbox-jobs
SANDBOX_BIND_HOST=127.0.0.1
SANDBOX_BIND_PORT=8090
