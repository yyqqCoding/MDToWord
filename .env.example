# Supabase Agent Runtime
SUPABASE_URL=
SUPABASE_AGENT_KEY=
AGENT_DATABASE_URL=
AGENT_CHECKPOINT_SCHEMA=agent_runtime

# Gate Runtime
ARTIFACT_ROOT=var/agent-artifacts
EXTENSION_MANIFEST_PATH=extension/dist/manifest.json
CLAIM_LEASE_SECONDS=300
MAX_CLAIM_ATTEMPTS=3
MIN_GATE_CONFIDENCE=0.80
POLL_INTERVAL_SECONDS=5
# 阶段 G 投产开关；保持 false 时 Scheduler 绝不领取生产反馈。
PRODUCTION_SCHEDULER_ENABLED=false

# B3 OpenAI-compatible Provider
MODEL_PROVIDER=openai_compatible
MODEL_NAME=
MODEL_API_KEY=
# 填 API 根路径，例如 https://api.example.com/v1；不要包含 /chat/completions。
MODEL_BASE_URL=
# 自定义模型不在 LangChain profile 时必须填写真实输入窗口。
MODEL_CONTEXT_WINDOW=
# 若兼容接口不直接返回 usage.cost，请按所选模型价格填写美元/百万 Token。
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
# Gate 短请求超时，范围 30～120 秒；默认保持 30 秒。
GATE_MODEL_TIMEOUT_SECONDS=30
# Repair Agent 必需的备用 OpenAI-compatible 接口。前两次请求使用主接口，第三次使用备用；
# 三个字段必须一起配置，不填完整的 /chat/completions 路径。
FALLBACK_MODEL_ENABLED=true
FALLBACK_MODEL_NAME=
FALLBACK_MODEL_API_KEY=
FALLBACK_MODEL_BASE_URL=
FALLBACK_MODEL_CONTEXT_WINDOW=
FALLBACK_MODEL_INPUT_COST_PER_MILLION=0
FALLBACK_MODEL_OUTPUT_COST_PER_MILLION=0
# 阶段 D 长源码请求的单次模型超时，范围 30～300 秒。
REPRODUCTION_MODEL_TIMEOUT_SECONDS=180
# Repair Agent 运行预算；上下文按模型窗口的 65%/85% 管理，不设固定总 Token 上限。
MAX_MODEL_CALLS_PER_RUN=12
MAX_TOOL_CALLS_PER_RUN=30
MAX_SANDBOX_SECONDS_PER_RUN=900
# 固定后端基线的 skipped 数量；修复后增加即验证失败。
BACKEND_BASELINE_SKIPPED=0

# B3 Langfuse Cloud
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AGENT_ENVIRONMENT=development
TRACE_CONTENT=false

# Stage D/E Controller（--reproduce、--repair 或 --publish 时读取）
GITHUB_REPOSITORY=yyqqCoding/MDToWord
# Fine-grained token，仅授予该仓库 Contents: read；不得传入 Worker。
GITHUB_READ_TOKEN=
SOURCE_WORKSPACE_ROOT=var/source-snapshots
# 本地 Worker 默认地址；常驻部署时改为 Controller 可访问的私有内网地址，禁止公网暴露。
SANDBOX_WORKER_URL=http://127.0.0.1:8090
# Controller 与 Worker 分别注入同一个内部认证值，不传给任务容器。
SANDBOX_WORKER_CREDENTIAL=

# Stage F GitHub App Publisher（仅 --publish 或生产 Scheduler 读取）
GITHUB_APP_ID=
# 推荐在部署 Secret 中保存完整 PEM；也支持用字面量 \n 表示换行。
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_URL=https://api.github.com
GITHUB_MAIN_BRANCH=main
# 必须包含 {trace_id}；按 Langfuse 项目的实际页面 URL 填写。
LANGFUSE_TRACE_URL_TEMPLATE=

# 公开展示站点（Trace Explorer）的运行完成回调。两项都留空即完全关闭推送，
# 站点退回按需补抓，Agent 行为不受影响。密钥必须与站点的 SITE_WEBHOOK_SECRET 一致。
TRACE_SITE_WEBHOOK_URL=
TRACE_SITE_WEBHOOK_SECRET=

# Render Feedback API（只注入公开后端；当前单 worker 使用进程内滑动窗口）
FEEDBACK_RATE_PER_MINUTE=1
FEEDBACK_RATE_PER_HOUR=5
FEEDBACK_RATE_PER_DAY=10
FEEDBACK_GLOBAL_RATE_PER_HOUR=30

# Stage C Worker-only（当前本地 Docker 使用；只注入 Worker，不传入任务容器）
SANDBOX_IMAGE_DIGEST=
SANDBOX_JOB_ROOT=var/sandbox-jobs
SANDBOX_BIND_HOST=127.0.0.1
SANDBOX_BIND_PORT=8090
