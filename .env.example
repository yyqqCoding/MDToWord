# Supabase Agent Runtime
SUPABASE_URL=
SUPABASE_AGENT_KEY=
AGENT_DATABASE_URL=
AGENT_CHECKPOINT_SCHEMA=agent_runtime

# Gate Runtime
ARTIFACT_ROOT=var/agent-artifacts
EXTENSION_MANIFEST_PATH=extension/dist/manifest.json
CLAIM_LEASE_SECONDS=300
MAX_CLAIM_ATTEMPTS=3
MIN_GATE_CONFIDENCE=0.80
POLL_INTERVAL_SECONDS=5

# B3 OpenAI-compatible Provider
MODEL_PROVIDER=openai_compatible
MODEL_NAME=
MODEL_API_KEY=
# 填 API 根路径，例如 https://api.example.com/v1；不要包含 /chat/completions。
MODEL_BASE_URL=
# 若兼容接口不直接返回 usage.cost，请按所选模型价格填写美元/百万 Token。
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0

# B3 Langfuse Cloud
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AGENT_ENVIRONMENT=development
TRACE_CONTENT=false
